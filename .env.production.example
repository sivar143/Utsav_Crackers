# Production deployment template. Copy to .env.production and replace every placeholder.
# PUBLIC_BASE_URL must be an HTTPS origin without a trailing slash.
PUBLIC_BASE_URL=https://shop.example.com
TLS_CERT_DIR=./deploy/tls

MYSQL_DATABASE=utsav_crackers
MYSQL_USER=utsav_app
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD

KEYCLOAK_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_KEYCLOAK_DB_PASSWORD
KEYCLOAK_ADMIN_USERNAME=REPLACE_WITH_A_UNIQUE_ADMIN_USERNAME
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_KEYCLOAK_ADMIN_PASSWORD
