# Production only. Never commit the completed .env.production file.
MYSQL_DATABASE=utsav_crackers
MYSQL_USER=utsav_app
MYSQL_PASSWORD=REPLACE_WITH_LONG_UNIQUE_RANDOM_SECRET
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
KEYCLOAK_ADMIN_USERNAME=kc-bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
# Must be a real HTTPS domain with DNS pointing to the EC2 Elastic IP.
PUBLIC_BASE_URL=https://REPLACE_WITH_YOUR_DOMAIN
# Host directory containing fullchain.pem and privkey.pem.
TLS_CERT_DIR=/opt/utsav/tls
