# Local development only. Copy to .env and replace every value before starting services.
MYSQL_DATABASE=utsav_crackers
MYSQL_USER=utsav_app
MYSQL_PASSWORD=replace_with_a_long_local_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_long_keycloak_admin_password
KEYCLOAK_DB_PASSWORD=replace_with_a_long_keycloak_database_password

# Used when running Spring Boot directly on the host.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/utsav_crackers?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=utsav_app
SPRING_DATASOURCE_PASSWORD=replace_with_a_long_local_mysql_password
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/utsav-crackers

# Optional email OTP delivery settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
