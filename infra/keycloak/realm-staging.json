{
  "realm": "utsav-crackers",
  "enabled": true,
  "displayName": "Utsav Crackers Staging",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      { "name": "CUSTOMER", "description": "Staging customer access" },
      { "name": "ADMIN", "description": "Staging administrative access" }
    ]
  },
  "clients": [
    {
      "clientId": "utsav-web",
      "name": "Utsav Crackers Staging Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8088/*"],
      "webOrigins": ["http://localhost:8088"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8088/*"
      }
    }
  ]
}
