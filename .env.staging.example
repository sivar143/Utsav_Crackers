# Staging only. Access the site through an SSH tunnel; do not expose it publicly.
MYSQL_DATABASE=utsav_crackers
MYSQL_USER=utsav_app
MYSQL_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_PASSWORD
KEYCLOAK_ADMIN_USERNAME=staging-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_PASSWORD
# The browser will access the service through the local SSH tunnel.
PUBLIC_BASE_URL=http://localhost:8088
